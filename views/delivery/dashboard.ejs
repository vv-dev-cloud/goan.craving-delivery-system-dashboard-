<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Delivery Dashboard · Goan Craving</title><link rel="stylesheet" href="/css/style.css"><script defer src="/js/dashboard.js"></script></head>
<body><div class="app-shell"><aside class="sidebar"><a class="brand" href="/delivery"><span class="brand-mark">GC</span><span><b>Goan Craving</b><small>Delivery portal</small></span></a><nav><a class="nav-link active" href="/delivery"><span>▦</span> Overview</a><a class="nav-link" href="/delivery#assigned"><span>▤</span> Assigned orders</a><a class="nav-link" href="/delivery/history"><span>◷</span> Delivery history</a></nav><div class="sidebar-bottom"><div class="support-note"><b>Need help?</b><p>Contact your employee manager for order or delivery support.</p></div><form method="post" action="/logout"><button class="nav-link logout" type="submit"><span>↪</span> Sign out</button></form></div></aside>
<main class="main-content"><header class="topbar"><div><span class="eyebrow">DELIVERY OPERATIONS</span><h1>Good day, <%= user.name.split(' ')[0] %> <span class="wave">✦</span></h1><p class="muted">Here’s your delivery activity at a glance.</p></div><div class="profile-pill"><span class="avatar"><%= user.name.charAt(0).toUpperCase() %></span><span><b><%= user.name %></b><small>Delivery staff</small></span></div></header>
<% if (notice) { const notices = {accepted:'Assignment accepted.', 'assignment-released':'Assignment returned to the employee queue.', 'picked-up':'Order marked out for delivery.', 'report-submitted':'Delivery report submitted for employee verification.', 'report-pending':'A report is already awaiting employee verification.', 'order-unavailable':'This order is no longer available for that action.', 'invalid-report':'Choose a valid delivery result.'}; %><div class="alert alert-success"><%= notices[notice] || notice %></div><% } %>
<section class="stats-grid"><article class="stat-card"><div class="stat-top"><span>Assigned orders</span><span class="stat-icon orange">▤</span></div><strong><%= stats.assigned %></strong><small>Ready or being prepared</small></article><article class="stat-card"><div class="stat-top"><span>Active deliveries</span><span class="stat-icon blue">↗</span></div><strong><%= stats.active %></strong><small>Currently on the way</small></article><article class="stat-card"><div class="stat-top"><span>Awaiting verification</span><span class="stat-icon violet">◷</span></div><strong><%= stats.pending %></strong><small>Reports sent to employee</small></article><article class="stat-card"><div class="stat-top"><span>Verified delivered</span><span class="stat-icon green">✓</span></div><strong><%= stats.completed %></strong><small>Approved by employee</small></article></section>
<section class="section-card" id="assigned"><div class="section-heading"><div><h2>Your assigned orders</h2><p class="muted">Order actions are available only while assigned to you.</p></div><span class="count-badge"><%= orders.length %> orders</span></div>
<% if (!orders.length) { %><div class="empty-state"><div class="empty-icon">▤</div><h3>No assigned orders yet</h3><p>New assignments from your employee manager will appear here.</p></div><% } else { %><div class="orders-list"><% orders.forEach(order => { %><article class="order-card"><div class="order-head"><div><span class="order-number">#<%= order.orderNumber %></span><span class="status status-<%= order.officialStatus.toLowerCase().replaceAll('_','-') %>"><%= order.officialStatus.replaceAll('_',' ') %></span></div><span class="order-date"><%= new Date(order.createdAt).toLocaleDateString('en-IN',{day:'2-digit',month:'short'}) %></span></div><div class="order-body"><div class="customer-block"><span class="customer-avatar"><%= (order.customer?.name || 'C').charAt(0).toUpperCase() %></span><div><b><%= order.customer?.name || 'Customer' %></b><small><%= order.customer?.phone || 'Phone not provided' %></small></div></div><div class="address-block"><span class="tiny-label">DELIVERY ADDRESS</span><p><%= order.customer?.address || 'Address unavailable' %></p><% if (order.customer?.instructions) { %><small class="muted">Note: <%= order.customer.instructions %></small><% } %></div><div class="order-total"><span class="tiny-label">ORDER TOTAL</span><b>₹<%= Number(order.total || 0).toFixed(2) %></b><small><%= order.paymentMethod || 'Payment' %> · <%= order.paymentStatus || 'Unknown' %></small></div></div><div class="order-actions">
<% if (!order.acceptedAt && ['CONFIRMED','PREPARING','READY_FOR_PICKUP'].includes(order.officialStatus)) { %><form method="post" action="/delivery/orders/<%= order._id %>/accept"><button class="btn btn-primary" type="submit">Accept assignment</button></form><form method="post" action="/delivery/orders/<%= order._id %>/reject" data-confirm="Return this assignment to the employee queue?"><button class="btn btn-light" type="submit">Reject</button></form><% } else if (order.officialStatus === 'READY_FOR_PICKUP') { %><form method="post" action="/delivery/orders/<%= order._id %>/pickup"><button class="btn btn-primary" type="submit">Confirm pickup</button></form><% } else if (order.officialStatus === 'OUT_FOR_DELIVERY') { %><details class="report-details"><summary class="btn btn-primary">Submit delivery result</summary><form class="report-form" method="post" action="/delivery/orders/<%= order._id %>/report"><label>Result<select name="result" required><option value="DELIVERED">Delivered</option><option value="UNABLE_TO_DELIVER">Unable to deliver</option></select></label><label>Customer OTP (if used)<input name="customerOtp" inputmode="numeric" maxlength="8" placeholder="Enter OTP"></label><label>Delivery note / proof reference<textarea name="proofNote" rows="2" maxlength="1000" placeholder="Add a brief delivery note"></textarea></label><button class="btn btn-primary" type="submit">Send for verification</button></form></details><% } else { %><span class="muted action-note">No action needed at this stage.</span><% } %></div></article><% }) %></div><% } %></section>
<section class="section-card"><div class="section-heading"><div><h2>Recent delivery reports</h2><p class="muted">Employee verification controls final order status.</p></div><a class="text-link" href="/delivery/history">View history →</a></div><% if (!reports.length) { %><p class="empty-inline">Your submitted reports will appear here.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Order</th><th>Result</th><th>Submitted</th><th>Verification</th></tr></thead><tbody><% reports.forEach(report => { %><tr><td><b>#<%= report.order?.orderNumber || 'Order' %></b></td><td><%= report.result.replaceAll('_',' ') %></td><td><%= new Date(report.createdAt).toLocaleDateString('en-IN') %></td><td><span class="status status-<%= report.verificationStatus.toLowerCase() %>"><%= report.verificationStatus.replaceAll('_',' ') %></span></td></tr><% }) %></tbody></table></div><% } %></section>
<footer class="page-footer">Goan Craving · Delivery operations <span>•</span> Employee approval required for final delivery status</footer></main></div></body></html>