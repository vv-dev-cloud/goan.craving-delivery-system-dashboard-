<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Delivery History · Goan Craving</title><link rel="stylesheet" href="/css/style.css"></head><body><div class="app-shell"><aside class="sidebar"><a class="brand" href="/delivery"><span class="brand-mark">GC</span><span><b>Goan Craving</b><small>Delivery portal</small></span></a><nav><a class="nav-link" href="/delivery">▦ Overview</a><a class="nav-link active" href="/delivery/history">◷ Delivery history</a></nav><div class="sidebar-bottom"><form method="post" action="/logout"><button class="nav-link logout" type="submit">↪ Sign out</button></form></div></aside><main class="main-content"><header class="topbar"><div><span class="eyebrow">DELIVERY OPERATIONS</span><h1>Delivery history</h1><p class="muted">Track submitted results and employee decisions.</p></div><a class="btn btn-light" href="/delivery">← Dashboard</a></header><section class="section-card"><% if (!reports.length) { %><div class="empty-state"><h3>No reports yet</h3><p>Submitted delivery reports will be listed here.</p></div><% } else { %><div class="table-wrap"><table><thead><tr><th>Order</th><th>Result</th><th>Submitted</th><th>Verification</th><th>Employee note</th></tr></thead><tbody><% reports.forEach(report => { %><tr><td><b>#<%= report.order?.orderNumber || 'Order' %></b></td><td><%= report.result.replaceAll('_',' ') %></td><td><%= new Date(report.createdAt).toLocaleString('en-IN') %></td><td><span class="status status-<%= report.verificationStatus.toLowerCase() %>"><%= report.verificationStatus.replaceAll('_',' ') %></span></td><td><%= report.employeeNote || '—' %></td></tr><% }) %></tbody></table></div><% } %></section></main></div></body></html>